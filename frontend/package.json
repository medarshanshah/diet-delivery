    "zod": "^3.22.2",
    "framer-motion": "^10.16.4",
    "react-intersection-observer": "^9.5.2",
    "react-image-gallery": "^1.3.0",
    "react-rating-stars-component": "^2.2.0",
    "react-select": "^5.7.4",
